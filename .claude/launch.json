{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd", "apps/api", "src/index.ts"],
      "env": {
        "DATABASE_URL": "postgres://postgres@localhost:5544/shifts",
        "CORS_ORIGIN": "http://localhost:3010",
        "PORT": "3001"
      },
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/web", "dev"],
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:3001" },
      "port": 3010
    }
  ]
}
