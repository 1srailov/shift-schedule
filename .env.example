# API (apps/api)
DATABASE_URL=postgres://postgres@localhost:5432/shifts
PORT=3001
# Allow the Next dev server to call the API in development
CORS_ORIGIN=http://localhost:3000
# Production: serve the static frontend from the same process
# STATIC_DIR=../web/out
# MIGRATE_ON_START=1
# SEED_ON_START=1

# Integration tests (separate database — it is wiped on every run!)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/shifts_test

# Web (apps/web) — only needed in dev, when API runs on another port
NEXT_PUBLIC_API_URL=http://localhost:3001
